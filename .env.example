# Copy to .env at the repository root and fill in what you need.
# Only the keys for the models you actually run are required.

# --- Online text classification ---
# Evaluation model (openrouter/openai/gpt-oss-120b, the default in config.yaml)
OPENROUTER_API_KEY=

# --- Terminal-Bench 2.1 ---
# GPT-5.6-Luna, hosted on Azure OpenAI. The key goes in AZURE_OPENAI_API_KEY and
# the endpoint URL (https://<resource>.openai.azure.com/) in AZURE_OPENAI_ENDPOINT.
# Values exported in the shell take precedence; blank lines here are ignored.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Qwen3.6-35B-A3B, served locally by vLLM. OPENAI_API_BASE is passed per command
# rather than set here, because it points at a specific host and port.
OPENAI_API_KEY=dummy

# --- Optional ---
# The proposer runs on subscription auth through the Claude Code CLI and does
# not need this. Set it only if you drive an evaluation model over the Anthropic
# API; meta_harness.py removes it from the proposer's environment either way, so
# that the CLI does not fall back to API billing.
ANTHROPIC_API_KEY=

# A local OpenAI-compatible server, if you use one for text classification
# (see make_local_llm in text_classification/llm.py)
LOCAL_LLM_HOST=localhost
LOCAL_LLM_PORT=30000

# Only if you run the Terminal-Bench sandbox on Modal instead of local Docker
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
